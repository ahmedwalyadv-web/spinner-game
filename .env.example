# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل في بيئة حقيقية

# المنفذ اللي السيرفر هيشتغل عليه
PORT=3000

# بيانات حساب الأدمن الافتراضي (بيتنشئ أول مرة بس - لو عايز تغيّره بعد كدة استخدم زرار "كلمة المرور" في الداشبورد)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# مفتاح سري لتوقيع جلسات تسجيل الدخول - غيّره لأي نص عشوائي طويل قبل النشر الحقيقي
JWT_SECRET=please-change-this-to-a-long-random-string
