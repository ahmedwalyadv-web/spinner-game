@echo off
chcp 65001 >nul
title لعبة السبنر - سيرفر محلي
cd /d "%~dp0"

if not exist node_modules (
  echo ================================================================
  echo   أول تشغيل: جاري تجهيز التطبيق... (محتاج إنترنت في المرة دي بس)
  echo ================================================================
  call npm install
  if errorlevel 1 (
    echo.
    echo حصل خطأ أثناء التجهيز. تأكد إن عندك اتصال بالإنترنت وإن Node.js متثبت.
    echo تقدر تنزل Node.js من: https://nodejs.org
    pause
    exit /b 1
  )
)

echo.
echo ================================================================
echo   السيرفر شغال دلوقتي على الجهاز ده - مش محتاج إنترنت خالص
echo ================================================================
echo   لوحة التحكم:   http://localhost:3000/admin
echo.
echo   عشان جهاز تاني (تابلت/موبايل) يفتح اللعبة، لازم يكون على نفس
echo   شبكة الواي فاي (حتى لو الواي فاي من غير إنترنت أصلاً)، وتفتح
echo   من عليه رابط بالشكل ده بدل localhost:
echo       http://[رقم-اللابتوب-على-الشبكة]:3000/play/...
echo   عشان تعرف رقم اللابتوب: افتح Command Prompt واكتب ipconfig
echo   وشوف قيمة "IPv4 Address"
echo ================================================================
echo.
echo (سيب النافذة دي شغالة طول وقت الفعالية - قفلها بيوقف السيرفر)
echo.

start "" http://localhost:3000/admin
node server\index.js

pause
